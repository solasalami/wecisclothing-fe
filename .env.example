# ---- Database (MySQL 8 / MariaDB) ----
# Option A (recommended for live): separate values, no escaping needed even if the password has ? # @ %
# DB_HOST=your-host.com
# DB_PORT=3306
# DB_USER=your_user
# DB_PASSWORD=your-password
# DB_NAME=your_database
# Option B: one URL (used when DB_HOST is not set). URL-encode special characters in the password (? -> %3F, # -> %23, @ -> %40).
DATABASE_URL=mysql://wecis:wecis_dev@127.0.0.1:3307/wecis
# Set to "true" if your hosted MySQL requires TLS (Aiven, TiDB Cloud, PlanetScale, etc.)
DATABASE_SSL=false
# Set to "true" only if your host uses a self-signed certificate with DATABASE_SSL=true
# DATABASE_SSL_ALLOW_SELF_SIGNED=false

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random string (openssl rand -base64 48)
AUTH_SECRET=change-me-to-a-long-random-string

# ---- File storage ----
# "blobs" on Netlify (automatic credentials), "local" for dev (writes to ./.uploads)
STORAGE_DRIVER=local

# ---- Tracking (leave blank until accounts exist) ----
NEXT_PUBLIC_GTM_ID=

# ---- Paystack (https://paystack.com/docs) ----
# Test keys start sk_test_ / pk_test_; live keys sk_live_ / pk_live_ (mode follows the key).
# Webhook URL to set in the Paystack dashboard: https://<your-site>/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# ---- OPay (https://doc.opaycheckout.com) ----
OPAY_ENV=sandbox
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
# Dev-only fake gateway so checkout can be tested without Paystack / OPay keys. Never enable in production.
PAYMENT_MOCK=true

# ---- Email (order confirmations) ----
# Sent when an order is paid: a confirmation to the customer + a notification to ADMIN_EMAIL.
SEND_EMAIL=false
SMTP_HOST=mail.wecisclothing.com
SMTP_PORT=587               # 587 = STARTTLS, 465 = SSL
SMTP_USER=sales@wecisclothing.com
SMTP_PASS=
FROM_EMAIL="Wecis Clothing Sales <sales@wecisclothing.com>"
ADMIN_EMAIL=info@wecisclothing.com
# Host name announced to the mail server (HELO/EHLO). Use your domain:
SMTP_HELO_NAME=wecisclothing.com
# Only if the mail server's certificate doesn't match SMTP_HOST (common on shared hosting):
# SMTP_TLS_REJECT_UNAUTHORIZED=false
